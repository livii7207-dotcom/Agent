<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme. The real Compose theme is defined in Vigil5Theme.kt;
         this is only here so the manifest's android:theme resolves and the
         system window chrome picks up sensible defaults before Compose
         takes over. -->
    <style name="Theme.Vigil5" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/vigil_surface_dark</item>
        <item name="android:navigationBarColor">@color/vigil_surface_dark</item>
        <item name="android:windowBackground">@color/vigil_surface_dark</item>
    </style>
</resources>
